# ============================================================
# BOSS 환경 변수 템플릿
# 복사 후 .env 로 저장하고 실제 값을 채워주세요.
# ⚠️  .env 는 절대 커밋하지 마세요.
# ============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (임베딩)
OPENAI_API_KEY=sk-...

# Anthropic (LLM)
ANTHROPIC_API_KEY=sk-ant-...

# 기업마당 공공 API
BIZINFO_API_KEY=your-bizinfo-key

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
