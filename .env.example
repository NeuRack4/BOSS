# ============================================================
# BOSS 환경 변수 템플릿
# 복사 후 .env 로 저장하고 실제 값을 채워주세요.
# ⚠️  .env 는 절대 커밋하지 마세요.
# ============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (LLM)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (레거시)
GEMINI_API_KEY=AIza...

# Groq - Llama 3.3 70B (무료 초안 생성: 14,400 req/일)
GROQ_API_KEY=gsk_...

# 기업마당 공공 API
BIZINFO_API_KEY=your-bizinfo-key

# 서울 열린데이터광장 API
SEOUL_OPEN_API_KEY=your-seoul-open-api-key

# 공공데이터포털 API
PUBLIC_DATA_API_KEY=your-public-data-api-key

# SMTP — Resend (https://resend.com)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your-resend-api-key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=BOSS 비서

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
